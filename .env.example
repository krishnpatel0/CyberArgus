# Argus Unified — deployment configuration
# Copy to .env, replace every CHANGE_ME value, and keep .env out of source control.

# Required: persistence and authentication
ARGUS_IMAGE=argus-unified:local
ARGUS_BIND_ADDRESS=127.0.0.1
ARGUS_PORT=7777
POSTGRES_USER=arguswatch
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_DB=arguswatch
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
AUTH_DISABLED=false
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
JWT_EXPIRE_HOURS=24
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ALLOWED_ORIGINS=http://127.0.0.1:7777
TRUSTED_PROXY_IPS=127.0.0.1

# Optional static API key for automation clients. Leave blank to disable.
API_KEY=

# AI enrichment is disabled by default. Rules, matching, scoring, and imports
# continue to operate without a model.
AI_AUTONOMOUS=false
AI_ACTIVE_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_VERSION=0.32.7
OLLAMA_MODEL=qwen3:8b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_MAPS_API_KEY=
OPENROUTER_API_KEY=
SERPAPI_KEY=
IMAGE_INTEL_BROWSER_SEARCH_ENABLED=true
IMAGE_INTEL_USE_SERPAPI=false
IMAGE_INTEL_VISION_MODEL=llava:7b
IMAGE_INTEL_OPENROUTER_MODEL=qwen/qwen2.5-vl-32b-instruct:free
IMAGE_INTEL_MAX_UPLOAD_MB=24
IMAGE_INTEL_MAX_MEGAPIXELS=50
IMAGE_INTEL_JOB_TTL_HOURS=168
IMAGE_INTEL_PROVIDER_TIMEOUT=90
IMAGE_INTEL_MAX_CROP_PASSES=2

# Telegram MTProto collection. All three account fields are required for live
# collection. TELEGRAM_CHANNELS must contain only channels you are authorized
# to monitor. Historical JSON/HTML/ZIP imports work without these credentials.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHANNELS=
TELEGRAM_BOT_TOKEN=

# Threat-intelligence and exposure providers (all optional)
GITHUB_TOKEN=
OTX_API_KEY=
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SECURITYTRAILS_API_KEY=
GRAYHATWARFARE_API_KEY=
LEAKIX_API_KEY=
PULSEDIVE_API_KEY=
GREYNOISE_API_KEY=
BINARYEDGE_API_KEY=
PHISHTANK_API_KEY=
PASTE_EE_API_KEY=

# Breach and dark-web providers (all optional)
HIBP_API_KEY=
BREACH_DIRECTORY_API_KEY=
BREACH_SEARCH_API_KEY=CHANGE_ME_RANDOM_INTERNAL_BREACH_API_KEY
BREACH_EMAIL_HASH_SALT=CHANGE_ME_RANDOM_PRIVATE_SALT
INTELBASE_API_KEY=
INTELBASE_EMAIL_LOOKUP_URL=https://api.intelbase.is/lookup/email
INTELX_API_KEY=
LEAKCHECK_API_KEY=
HUDSON_ROCK_API_KEY=
SOCRADAR_API_KEY=

# Enterprise connectors are key-activated; blank values keep them disabled.
SPYCLOUD_API_KEY=
RECORDED_FUTURE_KEY=
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_SECRET=
CYBERINT_API_KEY=
FLARE_API_KEY=
CYBERSIXGILL_CLIENT_ID=
CYBERSIXGILL_SECRET=
MANDIANT_API_KEY=

# Alerts and external service controls (optional)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
CISO_EMAIL=
AGENT_SIGNING_KEY=
TOR_PROXY=

# Local bind-mounted breach corpus. The directory is intentionally ignored by
# Git and is never copied into the Argus application image.
BREACH_DATA_PATH=./data/breach
ALLOW_UNSCOPED_RECON=false
PROMETHEUS_PORT=9091

# Internal data services
CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_CLICKHOUSE_PASSWORD
